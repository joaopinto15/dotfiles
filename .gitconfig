[user]
	name = João Pinto
	email = pintojad03@gmail.com
	signingkey = ~/.ssh/id_yubikey.pub

[core]
	editor = nvim

[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential

[gpg]
	format = ssh

[commit]
	gpgsign = true

[tag]
	gpgsign = true
