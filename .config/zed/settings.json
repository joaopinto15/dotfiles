{
  "theme": "One Dark",
  "icon_theme": "Material Icon Theme",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "fast_scroll_sensitivity": 20,
  "use_system_window_tabs": true,
  "title_bar": {
    "show_user_picture": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": false,
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    // NOTE: This might change in the future.
    "experimental.show": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },

  "rounded_selection": true,
  "colorize_brackets": true,
  "cursor_blink": false,
  "hide_mouse": "on_typing_and_action",
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "auto",
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "show": "auto",
  },

  "scroll_sensitivity": 10.0,
  "scroll_beyond_last_line": "off",
  "go_to_definition_scroll_strategy": "center",
  "close_on_file_delete": true,
  "restore_on_startup": "last_session",
  "diff_view_style": "split",
  "inline_code_actions": false,
  "lsp_document_colors": "inlay",
  "inlay_hints": {
    "enabled": false,
  },
  "wrap_guides": [90],
  "show_wrap_guides": true,
  "sticky_scroll": {
    "enabled": true,
  },
  // Rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  "use_smartcase_search": true,
  "search": {
    "button": false,
    "case_sensitive": true,
    "center_on_match": true,
  },

  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "on_yank",
  },

  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    // not sure yet if i'll turn this back on
    "auto_reveal_entries": false,
    "diagnostic_badges": true,
    "starts_open": true,
    "sticky_scroll": true,
    "dock": "right",
    "scrollbar": {
      "horizontal_scroll": false,
    },
  },

  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },

  "terminal": {
    "scroll_multiplier": 1.0,
    "keep_selection_on_copy": false,
    "toolbar": {
      "breadcrumbs": false,
    },
  },

  "disable_ai": false,
  "show_edit_predictions": true,
  "edit_predictions": {
    "mode": "subtle",
    "disabled_globs": [],
    "allow_data_collection": "no",
    "provider": "copilot",
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {},
    },
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },

  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "session": {
    // This might change in the future
    "trust_all_worktrees": true,
  },

  "languages": {},
  "file_types": {
    "Shell Script": ["tmux.conf"],
  },

  "profiles": {
    "YouTube": {
      "settings": {
        "show_wrap_guides": false,
        "ui_font_size": 24,
        "buffer_font_size": 24,
        "preferred_line_length": 75,
        "soft_wrap": "prefer_line",
        "scrollbar": {
          "show": "never",
        },
        "git": {
          "git_gutter": "hide",
          "inline_blame": {
            "enabled": false,
          },
        },
      },
    },
  },
}
